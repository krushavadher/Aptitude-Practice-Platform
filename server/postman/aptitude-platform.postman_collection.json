{
  "info": {
    "name": "Aptitude Practice Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.success && data.data && data.data.token) {",
                  "    pm.collectionVariables.set(\"studentToken\", data.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.success && data.data && data.data.token) {",
                  "    pm.collectionVariables.set(\"adminToken\", data.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Me (Student)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Topics",
      "item": [
        {
          "name": "Get All Topics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics"
              ]
            }
          }
        },
        {
          "name": "Create Topic (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.success && data.data && data.data._id) {",
                  "    pm.collectionVariables.set(\"topicId\", data.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quantitative Aptitude\",\n  \"category\": \"quant\",\n  \"subtopics\": [\"Percentages\", \"Profit & Loss\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/topics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "topics"
              ]
            }
          }
        },
        {
          "name": "Update Topic (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Quantitative\",\n  \"category\": \"quant\",\n  \"subtopics\": [\"Percentages\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "topics",
                "{{topicId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Topic (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "topics",
                "{{topicId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Questions (Admin)",
      "item": [
        {
          "name": "Create Manual Question",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.success && data.data && data.data._id) {",
                  "    pm.collectionVariables.set(\"questionId\", data.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicId\": \"{{topicId}}\",\n  \"text\": \"What is 10% of 200?\",\n  \"options\": [\"10\", \"20\", \"30\", \"40\"],\n  \"correctIndex\": 1,\n  \"explanation\": \"10/100 * 200 = 20\",\n  \"difficulty\": \"easy\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "questions"
              ]
            }
          }
        },
        {
          "name": "Get Questions List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/questions?difficulty=easy&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "questions"
              ],
              "query": [
                {
                  "key": "difficulty",
                  "value": "easy"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Update Question",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicId\": \"{{topicId}}\",\n  \"text\": \"What is 20% of 200?\",\n  \"options\": [\"10\", \"20\", \"30\", \"40\"],\n  \"correctIndex\": 3,\n  \"explanation\": \"20/100 * 200 = 40\",\n  \"difficulty\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "questions",
                "{{questionId}}"
              ]
            }
          }
        },
        {
          "name": "Generate AI Questions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicId\": \"{{topicId}}\",\n  \"subtopic\": \"Percentages\",\n  \"difficulty\": \"hard\",\n  \"count\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/ai/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "ai",
                "generate"
              ]
            }
          }
        },
        {
          "name": "Delete Question",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "questions",
                "{{questionId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Practice & Tests (Student)",
      "item": [
        {
          "name": "Get Practice Questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/practice/{{topicId}}?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "practice",
                "{{topicId}}"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Check Practice Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"selectedIndex\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/practice/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "practice",
                "check"
              ]
            }
          }
        },
        {
          "name": "Start Timed Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.success && data.data && data.data.testId) {",
                  "    pm.collectionVariables.set(\"testId\", data.data.testId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicId\": \"{{topicId}}\",\n  \"numQuestions\": 10,\n  \"durationSec\": 600,\n  \"difficulty\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tests/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests",
                "start"
              ]
            }
          }
        },
        {
          "name": "Submit Timed Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{questionId}}\",\n      \"selectedIndex\": 1,\n      \"timeSpentSec\": 15\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tests/{{testId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tests",
                "{{testId}}",
                "submit"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Leaderboard",
      "item": [
        {
          "name": "Global Leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard?period=all&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "all"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Topic Leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard/{{topicId}}?period=weekly",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leaderboard",
                "{{topicId}}"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "weekly"
                }
              ]
            }
          }
        }
      ]
    }
