# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=your_jwt_secret_min_32_characters_random_string

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL for CORS (comma-separated for multiple origins)
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# Optional: Initial Admin Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password

# Development Memory DB Fallback (set to false in production)
USE_MEMORY_DB_FALLBACK=false

# Optional: Email Service Configuration (for password reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_NAME=Aptitude Platform
FROM_EMAIL=noreply@aptitudeplatform.com
